p = [["P1", 5], ["P2", 3], ["P3", 4]]
q = 2
time = 0
wt = {}
tat = {}

while any(x[1] > 0 for x in p):
    for x in p:
        if x[1] > 0:
            t = min(q, x[1])
            time += t
            x[1] -= t
            if x[1] == 0:
                tat[x[0]] = time
                wt[x[0]] = time - 5 if x[0] == "P1" else time - 3 if x[0] == "P2" else time - 4

print("Process\tWT\tTAT")
for x in p:
    print(x[0], "\t", wt[x[0]], "\t", tat[x[0]])

print("Average WT:", sum(wt.values()) / len(p))
print("Average TAT:", sum(tat.values()) / len(p))

