p = [["P1", 5, 2], ["P2", 3, 1], ["P3", 4, 3]]
p.sort(key=lambda x: x[2])

time = 0
wt = {}
tat = {}

print("Process\tWT\tTAT")
for x in p:
    wt[x[0]] = time
    time += x[1]
    tat[x[0]] = time
    print(x[0], "\t", wt[x[0]], "\t", tat[x[0]])

print("Average WT:", sum(wt.values()) / len(p))
print("Average TAT:", sum(tat.values()) / len(p))
