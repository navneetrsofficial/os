
# ROUND ROBIN SCHEDULING

p = [["P1", 5], ["P2", 3], ["P3", 4], ["P4", 2]]
q = 2
bt = {x[0]: x[1] for x in p}
rem = bt.copy()
ct, chart, time = {}, [], 0

while any(rem.values()):
    for name in rem:
        if rem[name] > 0:
            t = min(q, rem[name])
            chart.append(name)
            time += t
            rem[name] -= t
            if rem[name] == 0:
                ct[name] = time

print("\nROUND ROBIN")
print("Process", "BT", "CT", "TAT", "WT", sep="\t")
wt, tat = [], []

for name, b in bt.items():
    t = ct[name]
    w = t - b
    wt.append(w)
    tat.append(t)
    print(name, b, t, t, w, sep="\t")

print("Average WT:", sum(wt)/4)
print("Average TAT:", sum(tat)/4)
print("Gantt Chart:", " | ".join(chart))


