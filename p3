
# ROUND ROBIN SCHEDULING

p = ["P1", "P2", "P3", "P4"]
at = [0, 1, 2, 4]
bt = [5, 4, 2, 1]

rt = bt.copy()
q = 2

ct = [0] * 4
time = 0
completed = 0

gantt = []

while completed < 4:

    found = False

    for i in range(4):

        if rt[i] > 0 and at[i] <= time:

            found = True

            gantt.append(p[i])

            if rt[i] > q:
                time += q
                rt[i] -= q
            else:
                time += rt[i]
                rt[i] = 0
                ct[i] = time
                completed += 1

    if not found:
        time += 1

tat = []
wt = []

for i in range(4):
    tat.append(ct[i] - at[i])
    wt.append(tat[i] - bt[i])

print("Gantt Chart:")
print(gantt)

print("\nPID\tAT\tBT\tCT\tTAT\tWT")

for i in range(4):
    print(p[i], "\t", at[i], "\t", bt[i],
          "\t", ct[i], "\t", tat[i], "\t", wt[i])

print("\nAverage Waiting Time:", sum(wt)/4)
print("Average Turnaround Time:", sum(tat)/4)

#--------------------------------------------------------------------------


# PRIORITY SCHEDULING

p = ["P1", "P2", "P3", "P4"]
at = [0, 1, 2, 3]
bt = [4, 3, 1, 5]
pr = [2, 1, 4, 3]

ct = [0] * 4
tat = [0] * 4
wt = [0] * 4
done = [0] * 4

time = 0
completed = 0
gantt = []

while completed < 4:

    index = -1

    for i in range(4):
        if done[i] == 0 and at[i] <= time:

            if index == -1 or pr[i] < pr[index]:
                index = i

    if index == -1:
        time += 1
        continue

    gantt.append(p[index])

    time += bt[index]

    ct[index] = time
    tat[index] = ct[index] - at[index]
    wt[index] = tat[index] - bt[index]

    done[index] = 1
    completed += 1

print("Gantt Chart:")
print(gantt)

print("\nPID\tAT\tBT\tPR\tCT\tTAT\tWT")

for i in range(4):
    print(p[i], "\t", at[i], "\t", bt[i],
          "\t", pr[i], "\t", ct[i], "\t",
          tat[i], "\t", wt[i])

print("\nAverage Waiting Time:", sum(wt)/4)
print("Average Turnaround Time:", sum(tat)/4)

