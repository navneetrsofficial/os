# PRIORITY SCHEDULING

p = [["P1", 5, 2], ["P2", 3, 1],
     ["P3", 4, 3], ["P4", 2, 4]]

p.sort(key=lambda x: x[2])
time = 0
wt, tat = [], []

print("\nPRIORITY SCHEDULING")
print("Process", "BT", "Priority", "CT", "TAT", "WT", sep="\t")

for name, b, pr in p:
    w = time
    time += b
    t = time
    wt.append(w)
    tat.append(t)
    print(name, b, pr, t, t, w, sep="\t")

print("Average WT:", sum(wt)/4)
print("Average TAT:", sum(tat)/4)
print("Gantt Chart:", " | ".join(x[0] for x in p))
