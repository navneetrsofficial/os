p = [
    ["P1", 0, 6],
    ["P2", 1, 8],
    ["P3", 2, 7],
    ["P4", 3, 3],
    ["P5", 4, 4]
]

time = 0
total_wt = 0
total_tat = 0

print("p\tAT\tBT\tCT\tTAT\tWT")

gantt = "0"
chart = []

for p in p:

    name = p[0]
    at = p[1]
    bt = p[2]

    if time < at:
        time = at

    time = time + bt

    ct = time
    tat = ct - at
    wt = tat - bt

    total_wt = total_wt + wt
    total_tat = total_tat + tat

    print(name, "\t", at, "\t", bt, "\t", ct, "\t", tat, "\t", wt)

    gantt = gantt + " -- " + name + " -- " + str(ct)
    chart.append(name)

print("\nAverage Waiting Time =", total_wt / 5)
print("Average Turnaround Time =", total_tat / 5)

print("\nGantt Chart:")
print(gantt)
